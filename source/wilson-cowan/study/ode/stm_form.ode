# the same E-I network written for the inputs (STM / 'voltage' form)
S(x,a,th)=1/(1+exp(-a*(x-th)))-1/(1+exp(a*th))
fe(x)=(1-1/(1+exp(ae*the)))*0+S(x,ae,the)
fi(x)=S(x,ai,thi)
ue'=-ue+c1*fe(ue)-c2*fi(ui)+p
ui'=-ui+c3*fe(ue)-c4*fi(ui)+q
par c1=16,c2=12,c3=15,c4=3,ae=1.3,the=4,ai=2,thi=3.7,p=1.25,q=0
init ue=0.5,ui=0.2
@ meth=cvode,tol=1e-9,atol=1e-9,dt=0.02,total=100,maxstor=500000,bound=100000
done
