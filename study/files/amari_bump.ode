# Amari neural field on a ring, Mexican-hat kernel: a bump persists after the stimulus (Chapter 8)
f(z)=1/(1+exp(-b*(z-th)))
table w % 145 -72 72 (0.125)*(1.5*exp(-(t*0.125)^2)-0.6*exp(-((t*0.125)/3)^2))
fu[0..239]=f(u[j])
special k=conv(periodic,240,72,w,fu0)
u[0..239]'=-u[j]+k([j])+s*exp(-(([j]-120)*0.125)^2)*heav(ton-t)
par b=50,th=0.3,s=1,ton=5
@ meth=rk4,dt=0.02,total=40,maxstor=20000,bound=1e6
done
